---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const labels: Record<string, string> = {
  consensus: 'consensus & replication',
  design: 'system design',
  path: 'the path',
};
---

<Base title="Writing — Konstantin Kim" description="Notes on consensus, replication, and building distributed systems by hand.">
  <h1>Writing</h1>
  <p class="lede muted">
    One piece every two weeks: what the broker broke, what production taught that the spec
    doesn't, and how the skill was actually acquired.
  </p>

  {
    posts.length === 0 && <p class="muted">Nothing published yet. The first one is in the works.</p>
  }

  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}/`}>{post.data.title}</a>
          <div class="muted meta">
            {post.data.date.toISOString().slice(0, 10)} · {labels[post.data.pillar]}
          </div>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <style>
    .posts { list-style: none; padding: 0; }
    .posts li { border-top: 1px solid var(--line); padding: 1.1rem 0; }
    .posts a { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 1.05rem; font-weight: 600; }
    .meta { font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.8rem; margin-top: 0.2rem; }
    .posts p { margin: 0.35rem 0 0; font-size: 0.95rem; }
  </style>
</Base>
