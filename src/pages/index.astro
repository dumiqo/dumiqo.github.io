---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Base
  title="Konstantin Kim — backend engineer, distributed systems"
  description="Backend engineer working on distributed systems: consensus and replication. Building a queue broker on a hand-written Raft core."
>
  <h1>Backend engineer working on distributed systems — consensus and replication.</h1>
  <p class="lede">
    I'm building a queue broker on a hand-written Raft core, and writing down what breaks.
  </p>

  <section>
    <h2>What I do</h2>
    <table>
      <!--
        Scope card. Public-safe by construction: role and system shape only.
        Never: employer name, internal architecture, incidents, customer or project specifics.
        Fill the bracketed facts once, keep them current.
      -->
      <tbody>
        <tr>
          <th>Role</th>
          <td>Backend engineer — services, storage, message flow.</td>
        </tr>
        <tr>
          <th>Systems</th>
          <td>
            Queue and message pipelines, transactional storage, service-to-service
            contracts. The side project with all the receipts is
            <a href="https://github.com/dumiqo/raft-broker">raft-broker</a>: a clustered queue
            broker whose guarantees rest on a Raft core I'm writing from the spec.
          </td>
        </tr>
        <tr>
          <th>Stack</th>
          <td><code>C#/.NET</code> for the broker, <code>Go</code>, <code>Kafka</code>, <code>PostgreSQL</code> day to day.</td>
        </tr>
        <tr>
          <th>Currently</th>
          <td>Leader election and log replication correctness — safety (§5.4) and liveness debugging on deterministic test clocks.</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section>
    <h2>Read / hire</h2>
    <ul>
      <li><a href="/writing/">Writing</a> — consensus, practical system design, and how the skill was acquired.</li>
      <li><a href="https://github.com/dumiqo">GitHub</a> — <a href="https://github.com/dumiqo/raft-broker">raft-broker</a> and the rest.</li>
      <!-- links:uncomment-when-exists — add the CV PDF and the LinkedIn URL here before the second post ships -->
      <!-- <li><a href="/cv.pdf">CV (PDF)</a></li> -->
      <!-- <li><a href="https://www.linkedin.com/in/HANDLE">LinkedIn</a></li> -->
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section>
        <h2>Latest</h2>
        <ul>
          {posts.map((post) => (
            <li>
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              <span class="muted"> — {post.data.date.toISOString().slice(0, 10)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <style>
    table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
    th, td { text-align: left; vertical-align: top; padding: 0.6rem 1rem 0.6rem 0; border-top: 1px solid var(--line); }
    th { width: 8rem; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.85rem; font-weight: 600; color: var(--muted); }
    section { margin-top: 2.75rem; }
    h2 { font-size: 1.05rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 600; }
    ul { padding-left: 1.1rem; }
    li { margin: 0.4rem 0; }
  </style>
</Base>
