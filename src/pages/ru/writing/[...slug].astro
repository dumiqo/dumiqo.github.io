---
import { getCollection } from 'astro:content';
import PostPage from '../../../views/Post.astro';
import { langOf, slugOf } from '../../../lib/posts';

export async function getStaticPaths() {
  // Same rule as the English page: drafts render in `astro dev` only.
  const posts = await getCollection('blog', (post) => (!post.data.draft || import.meta.env.DEV) && langOf(post) === 'ru');
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<PostPage post={post} />
