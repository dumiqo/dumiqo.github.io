---
import { feedHref, href, t, type Lang } from '../i18n';

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  // Where "switch language" goes. A post passes its translation; a page that exists
  // in both languages passes its own counterpart. Omitted = no switcher.
  switchHref?: string;
  // hreflang alternates, for pages that exist in both languages.
  alternates?: { lang: Lang; href: string }[];
  // Social preview image, relative to the site root. Absent is normal: the card then
  // falls back to title + description with no image.
  image?: string;
  ogType?: 'website' | 'article';
  // The card's headline without the « — site name» tail the <title> carries: LinkedIn
  // truncates around 100 characters, and the tail is the part nobody needs there.
  ogTitle?: string;
}

const {
  title,
  lang,
  description,
  switchHref,
  alternates = [],
  image,
  ogType = 'website',
  ogTitle = title,
} = Astro.props;
const copy = t(lang);
const site = Astro.site ?? new URL('https://dumiqo.github.io');
const absolute = (path: string) => new URL(path, site).toString();
const canonical = new URL(Astro.url.pathname, site);
// x-default is the English page when one exists, otherwise whichever language does.
const xDefault = alternates.find((alt) => alt.lang === 'en')?.href ?? alternates[0]?.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <!-- Link previews read og:*, not the page. LinkedIn is the only distribution channel
         for the first six months, and a shared link without an image is a text-only card. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={copy.siteName} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    {image && <meta property="og:image" content={absolute(image)} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={copy.feedTitle}
      href={feedHref(lang)}
    />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={absolute(alt.href)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault)} />}
    <style is:global>
      :root {
        --bg: #fbfaf8;
        --fg: #1a1a1a;
        --muted: #6b6862;
        --line: #e3e0da;
        --accent: #2f5d50;
        color-scheme: light dark;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14140f;
          --fg: #ecebe6;
          --muted: #9a968c;
          --line: #2c2c26;
          --accent: #86c7ab;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 17px/1.65 ui-serif, Georgia, 'Iowan Old Style', 'Times New Roman', serif;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 44rem; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h2, h3 { font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif; line-height: 1.25; letter-spacing: -0.01em; }
      h1 { font-size: 1.75rem; margin: 0 0 0.75rem; }
      header.site { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line); margin-bottom: 2.5rem; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.9rem; }
      header.site nav a { margin-left: 1rem; color: var(--muted); }
      header.site nav a.lang { color: var(--accent); }
      header.site .brand { font-weight: 600; letter-spacing: -0.01em; }
      footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-family: ui-sans-serif, system-ui, sans-serif; font-size: 0.85rem; }
      .lede { font-size: 1.15rem; }
      .muted { color: var(--muted); }
      code { font-family: ui-monospace, 'SF Mono', Consolas, monospace; font-size: 0.9em; }
      pre { padding: 1rem; border-radius: 6px; overflow-x: auto; border: 1px solid var(--line); }
      blockquote { margin: 1.5rem 0; padding-left: 1rem; border-left: 2px solid var(--line); color: var(--muted); }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="brand" href={href(lang)}>{copy.siteName}</a>
        <nav>
          <a href={href(lang, 'writing/')}>{copy.navWriting}</a>
          <a href="https://github.com/dumiqo">{copy.navGithub}</a>
          {
            switchHref && (
              <a class="lang" href={switchHref} hreflang={lang === 'ru' ? 'en' : 'ru'}>
                {copy.switchTo}
              </a>
            )
          }
        </nav>
      </header>
      <slot />
      <footer>
        <p>
          dumiqo · <a href="https://github.com/dumiqo/raft-broker">raft-broker</a> · <a
            href={feedHref(lang)}>{copy.footerRss}</a
          >
        </p>
      </footer>
    </div>
  </body>
</html>
